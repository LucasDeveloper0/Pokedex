generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Trainer {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  originRegion String
  password     String
  badges       Badge[]
  captured     CapturedPokemon[]
  teams        Team[]
}

model Pokemon {
  id          String            @id @default(uuid())
  pokedexNum  Int               @unique
  name        String
  type1       String
  type2       String?
  evolvesToId String?           @unique
  instances   CapturedPokemon[]
  evolvesTo   Pokemon?          @relation("EvolutionChain", fields: [evolvesToId], references: [id])
  evolvesFrom Pokemon?          @relation("EvolutionChain")
}

model CapturedPokemon {
  id         String       @id @default(uuid())
  nickname   String?
  level      Int          @default(1)
  trainerId  String
  pokemonId  String
  pokemon    Pokemon      @relation(fields: [pokemonId], references: [id])
  trainer    Trainer      @relation(fields: [trainerId], references: [id])
  teamMember TeamMember[]
}

model Team {
  id        String       @id @default(uuid())
  name      String
  trainerId String
  trainer   Trainer      @relation(fields: [trainerId], references: [id])
  members   TeamMember[]
}

model TeamMember {
  id         String          @id @default(uuid())
  teamId     String
  capturedId String
  captured   CapturedPokemon @relation(fields: [capturedId], references: [id])
  team       Team            @relation(fields: [teamId], references: [id])
}

model Badge {
  id          String      @id @default(uuid())
  name        String
  gym         String
  trainerId   String
  GlobalBadge GlobalBadge @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainer     Trainer     @relation(fields: [trainerId], references: [id])
}

model GlobalBadge {
  id    String @id @default(uuid())
  name  String
  gym   String
  Badge Badge?
}
