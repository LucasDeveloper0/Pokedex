datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Trainer {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  password     String
  originRegion String
  captured     CapturedPokemon[]
  teams        Team[]
  badges       Badge[]
}

model Pokemon {
  id           String            @id @default(uuid())
  pokedexNum   Int               @unique
  name         String
  type1        String
  type2        String?
  
  // Relação de Auto-referência (A Mágica!)
  evolvesToId  String?           @unique
  evolvesTo    Pokemon?          @relation("EvolutionChain", fields: [evolvesToId], references: [id])
  evolvesFrom  Pokemon?          @relation("EvolutionChain")

  instances    CapturedPokemon[]
}

model CapturedPokemon {
  id         String       @id @default(uuid())
  nickname   String?
  level      Int          @default(1)
  trainerId  String
  trainer    Trainer      @relation(fields: [trainerId], references: [id])
  pokemonId  String
  pokemon    Pokemon      @relation(fields: [pokemonId], references: [id])
  teamMember TeamMember[]
}

model Team {
  id        String       @id @default(uuid())
  name      String
  trainerId String
  trainer   Trainer      @relation(fields: [trainerId], references: [id])
  members   TeamMember[]
}

model TeamMember {
  id         String          @id @default(uuid())
  teamId     String
  team       Team            @relation(fields: [teamId], references: [id])
  capturedId String
  captured   CapturedPokemon @relation(fields: [capturedId], references: [id])
}

model Badge {
  id        String  @id @default(uuid())
  name      String
  gym       String
  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id])
}

model GlobalBadge {
  id   String @id @default(uuid())
  name String
  gym  String
}